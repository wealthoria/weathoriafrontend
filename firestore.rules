rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Published content can be viewed publicly
    match /content/{document} {
      allow read: if resource.data.status == "published";
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Members can read only their own course purchases
    match /coursePurchases/{document} {
      allow read: if request.auth != null
        && resource.data.userId == request.auth.uid;

      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // YouTube videos
    match /youtube_videos/{document} {
      // Public can read published videos
      allow read: if resource.data.published == true;

      // Only admins can create/update/delete
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Members
    match /members/{userId} {
      allow read: if request.auth != null
        && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Subscriptions
    match /subscriptions/{document} {
      allow read: if request.auth != null
        && resource.data.memberId == request.auth.uid;

      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Day-by-Day Content Engagement Tracking
    match /member_usage_daily/{date} {
      allow read, write: if true;
    }

    match /member_activity_logs/{logId} {
      allow read, write: if true;
    }

    match /member_usage_summary/{memberId} {
      allow read, write: if true;
    }

    // Admins can access all other documents
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }
  }
}