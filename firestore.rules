rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Published content can be viewed publicly, admins can read all
    match /content/{document} {
      allow read: if resource.data.status == "published"
        || (request.auth != null && request.auth.token.admin == true);
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Members can read only their own course purchases, admins can read all
    match /coursePurchases/{document} {
      allow read: if request.auth != null
        && (resource.data.userId == request.auth.uid || request.auth.token.admin == true);

      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // YouTube videos
    match /youtube_videos/{document} {
      // Public can read published videos, admins can read all
      allow read: if resource.data.published == true
        || (request.auth != null && request.auth.token.admin == true);

      // Only admins can create/update/delete
      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Members
    match /members/{userId} {
      allow read: if request.auth != null
        && (request.auth.uid == userId || request.auth.token.admin == true);

      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Subscriptions
    match /subscriptions/{document} {
      allow read: if request.auth != null
        && (resource.data.memberId == request.auth.uid || request.auth.token.admin == true);

      allow write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Day-by-Day Content Engagement Tracking
    match /member_usage_daily/{date} {
      allow read, write: if true;
    }

    match /member_activity_logs/{logId} {
      allow read, write: if true;
    }

    match /member_usage_summary/{memberId} {
      allow read, write: if true;
    }

    // Video Likes and Comments
    match /videocomments/{commentId} {
      allow read, write: if true;
    }

    match /videolikes/{likeId} {
      allow read, write: if true;
    }

    match /video_comments/{commentId} {
      allow read, write: if true;
    }

    match /video_likes/{likeId} {
      allow read, write: if true;
    }

    // Courses, students, and notifications
    match /courses/{document} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /students/{document} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /notifications/{document} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    // Orders, coupons, enquiries, followups, seminar registrations
    match /bookOrders/{document} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /enquiries/{document} {
      allow read, update, delete: if request.auth != null
        && request.auth.token.admin == true;
      allow create: if true;
    }

    match /coupons/{document} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /member_followups/{document} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }

    match /seminar_registrations/{document} {
      allow read, update, delete: if request.auth != null
        && request.auth.token.admin == true;
      allow create: if true;
    }

    // Admins can access all other documents
    match /{document=**} {
      allow read, write: if request.auth != null
        && request.auth.token.admin == true;
    }
  }
}