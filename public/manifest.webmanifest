{
  "name": "Wealthoria — Learning is the first investment",
  "short_name": "Wealthoria",
  "description": "Financial literacy and investment education for first-time investors across Karnataka. Learn in Kannada and English.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#e8ebe6",
  "theme_color": "#e8473f",
  "lang": "en",
  "dir": "ltr",
  "prefer_related_applications": false,
  "related_applications": [
    {
      "platform": "webapp",
      "url": "https://www.wealthoria.in/manifest.webmanifest"
    }
  ],
  "categories": [
    "education",
    "finance"
  ],
  "icons": [
    {
      "src": "icons/icon-192-any.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-512-any.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Start learning",
      "short_name": "Learn",
      "description": "Browse Wealthoria learning programs",
      "url": "Wealthoria.html#programs",
      "icons": [
        {
          "src": "icons/icon-192-any.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    },
    {
      "name": "Student login",
      "short_name": "Student",
      "description": "Access your courses and progress",
      "url": "Student Portal.html",
      "icons": [
        {
          "src": "icons/icon-192-any.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ]
    }
  ]
}