rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Only Firebase users carrying the `admin` custom claim may read.
    // Members do NOT sign in with Firebase Auth (login.jsx signs non-admins
    // out and uses backend bearer tokens), so a Firestore-status check on
    // request.auth.uid would never match a real member. Member-facing files
    // are served by the backend, not by direct Storage reads.
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Course thumbnails
    match /members/course-thumbnails/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Content thumbnails
    match /members/content-thumbnails/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Content PDFs
    match /members/content-pdfs/{allPaths=**} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
