{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "rewrites": [
    {
      "source": "/",
      "destination": "/Wealthoria.html"
    },
    {
      "source": "/members/login",
      "destination": "/index.html"
    },
    {
      "source": "/members/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/members/course-videos",
      "destination": "/index.html"
    },
    {
      "source": "/members/newsletter",
      "destination": "/index.html"
    },
    {
      "source": "/members/purchase-history",
      "destination": "/index.html"
    },
    {
      "source": "/members/market-roundup",
      "destination": "/index.html"
    },
    {
      "source": "/members/forgot-password",
      "destination": "/index.html"
    }
  ]
}