{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "cleanUrls": false,
  "functions": {
    "api/lab-bundle.js": {
      "includeFiles": "private/lab-engine.js"
    }
  },
  "redirects": [
    {
      "source": "/Wealthoria.html",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/wealthoria.html",
      "destination": "/",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/wealthoria-disclosure.html",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; script-src 'self' 'unsafe-inline'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/(.*\\.pdf)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/artofbookhomepage",
      "destination": "/artofbookhomepage.html"
    },
    {
      "source": "/the-art-of-price",
      "destination": "/artofbookhomepage.html"
    },
    {
      "source": "/the-art-of-price-kannada",
      "destination": "/the-art-of-price-kannada.html"
    },
    {
      "source": "/the-art-of-price-english",
      "destination": "/the-art-of-price-english.html"
    },
    {
      "source": "/the-art-of-price/kn",
      "destination": "/the-art-of-price-kannada.html"
    },
    {
      "source": "/the-art-of-price/en",
      "destination": "/the-art-of-price-english.html"
    },
    {
      "source": "/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/thank-you/",
      "destination": "/thank-you.html"
    },
    {
      "source": "/the-art-of-price/thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/the-art-of-price/thank-you/",
      "destination": "/thank-you.html"
    },
    {
      "source": "/the-art-of-price-thank-you",
      "destination": "/thank-you.html"
    },
    {
      "source": "/the-art-of-price-prebook",
      "destination": "/the-art-of-price-prebook.html"
    },
    {
      "source": "/art-of-price-prebook",
      "destination": "/the-art-of-price-prebook.html"
    },
    {
      "source": "/the-art-of-price-prebooking",
      "destination": "/the-art-of-price-prebooking.html"
    },
    {
      "source": "/customer-details",
      "destination": "/customer-details.html"
    },
    {
      "source": "/prebook",
      "destination": "/prebook.html"
    },
    {
      "source": "/kannada-book",
      "destination": "/kannada-book.html"
    },
    {
      "source": "/membership",
      "destination": "/membership.html"
    },
    {
      "source": "/calculators",
      "destination": "/Fundamental_Analysis_Lab.html"
    },
    {
      "source": "/calculators/",
      "destination": "/Fundamental_Analysis_Lab.html"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/kn",
      "destination": "/index.html"
    },
    {
      "source": "/kn/",
      "destination": "/index.html"
    },
    {
      "source": "/members/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    }
  ]
}